# hzacc_unimag_state.template - UNIMAG state readback
#
# Included by hzacc_cubicle.db and hzacc_channel.template.
#
# STATE_RB (aligned across the UNIMAG power-supply IOCs):
#   0 OFF | 1 ON | 2 STANDBY | 3 FAULT (MAJOR) | 4 EXT_INTLK (MAJOR)
#   5 CONN_FAULT (MAJOR, communication errors)
#   6 SP_NOT_REACHED (MINOR, current setpoint not reached)
#   7 ST_NOT_REACHED (MAJOR, commanded state not reached)
#   8.. additional, device specific states
#
# The device logic decodes the plain state (0-5) into STATE_BASE. 6 and 7
# come on top of it from SP_NOT_REACHED / ST_NOT_REACHED, and STATE_FINAL
# selects what STATE_RB shows: faults win, then ST_NOT_REACHED, then
# SP_NOT_REACHED.
#
# The including file must provide the records SP_NOT_REACHED and
# ST_NOT_REACHED (FLNK STATE_FINAL): the channels from the UNIMAG state
# machine (hzacc_unimag_sm.template), the cubicle from the state watchdog
# (hzacc_unimag_stwdog.template).
#
# Macros:
#   P, R           PV prefix
#   SET_TIMEOUT_S  (s) how long the setpoint / state may stay unreached
#                      without progress before it is retried / reported
#                      (default 30)

record(ao, "$(P):$(R):SET_TIMEOUT_S") {
    field(DESC, "Setpoint/state timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "3600")
}

# Plain decoded state (0-5), written by the device logic
record(ao, "$(P):$(R):STATE_BASE") {
    field(DESC, "Decoded state without 6/7")
    field(FLNK, "$(P):$(R):STATE_FINAL")
}

# Final state: faults win, then ST_NOT_REACHED, then SP_NOT_REACHED
record(calcout, "$(P):$(R):STATE_FINAL") {
    field(DESC, "Final state incl. NOT_REACHED")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(INPB, "$(P):$(R):ST_NOT_REACHED NPP NMS")
    field(INPC, "$(P):$(R):SP_NOT_REACHED NPP NMS")
    field(CALC, "(A>=3&&A<=5)?A:(B?7:(C?6:A))")
    field(OUT,  "$(P):$(R):STATE_RB PP")
    field(OOPT, "Every Time")
}

record(mbbi, "$(P):$(R):STATE_RB") {
    field(DESC, "State readback")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "FAULT")
    field(THSV, "MAJOR")
    field(FRVL, "4")
    field(FRST, "EXT_INTLK")
    field(FRSV, "MAJOR")
    field(FVVL, "5")
    field(FVST, "CONN_FAULT")
    field(FVSV, "MAJOR")
    field(SXVL, "6")
    field(SXST, "SP_NOT_REACHED")
    field(SXSV, "MINOR")
    field(SVVL, "7")
    field(SVST, "ST_NOT_REACHED")
    field(SVSV, "MAJOR")
}
