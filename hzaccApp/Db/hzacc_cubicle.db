########################################################################################
### Commands ($0000) - pulsed: the code is written, then cleared after PULSE seconds
########################################################################################

record(ao, "$(P):$(R):CMD_WORD") {
    field(DESC, "General command word")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT_CMD),0,$(TIMEOUT))MODBUS_DATA")
}

record(ao, "$(P):$(R):CMD_VAL") {
    field(DESC, "Command code to pulse")
    field(FLNK, "$(P):$(R):CMD_PULSE")
}

record(seq, "$(P):$(R):CMD_PULSE") {
    field(DESC, "Pulse the command word")
    field(SELM, "All")
    field(DOL1, "$(P):$(R):CMD_VAL NPP")
    field(LNK1, "$(P):$(R):CMD_WORD PP")
    field(DLY2, "$(PULSE=0.5)")
    field(DOL2, "0")
    field(LNK2, "$(P):$(R):CMD_WORD PP")
}

record(bo, "$(P):$(R):ACT_ENERGY_RST") {
    field(DESC, "Reset active energy counter")
    field(ZNAM, "Normal")
    field(ONAM, "Reset")
    field(FLNK, "$(P):$(R):ACT_ENERGY_RST_CMD")
}

record(calcout, "$(P):$(R):ACT_ENERGY_RST_CMD") {
    field(INPA, "$(P):$(R):ACT_ENERGY_RST")
    field(CALC, "A")
    field(OOPT, "When Non-zero")
    field(OCAL, "16")
    field(DOPT, "Use OCAL")
    field(OUT,  "$(P):$(R):CMD_VAL PP")
}

record(bo, "$(P):$(R):REACT_ENERGY_RST") {
    field(DESC, "Reset reactive energy counter")
    field(ZNAM, "Normal")
    field(ONAM, "Reset")
    field(FLNK, "$(P):$(R):REACT_ENERGY_RST_CMD")
}

record(calcout, "$(P):$(R):REACT_ENERGY_RST_CMD") {
    field(INPA, "$(P):$(R):REACT_ENERGY_RST")
    field(CALC, "A")
    field(OOPT, "When Non-zero")
    field(OCAL, "32")
    field(DOPT, "Use OCAL")
    field(OUT,  "$(P):$(R):CMD_VAL PP")
}

########################################################################################
### UNIMAG state
########################################################################################
# Cubicle state descriptor (Power, Standby, Ready):
#   Faulty 000/010 -> FAULT, Energized 001 -> OFF, Standby 011 -> STANDBY,
#   Power On 111 -> ON. CONN_FAULT when the status word cannot be read.

record(calcout, "$(P):$(R):STATE_RB_CALC") {
    field(DESC, "State readback")
    field(INPA, "$(P):$(R):READY CP")
    field(INPB, "$(P):$(R):STANDBY_STS CP")
    field(INPC, "$(P):$(R):POWER_STS CP")
    field(INPD, "$(P):$(R):GEN_STATUS.SEVR CP NMS")
    field(CALC, "D>=3?5:(!A?3:(C?1:(B?2:0)))")
    field(OUT,  "$(P):$(R):STATE_BASE PP")
    field(OOPT, "Every Time")
}

record(mbbo, "$(P):$(R):STATE_SP") {
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FLNK, "$(P):$(R):STATE_DISPATCH")
}

# OFF -> Power Off (4), ON -> see POWER_ON_SEQ, STANDBY -> Standby (1),
# RESET -> Remote Reset (8)
record(seq, "$(P):$(R):STATE_DISPATCH") {
    field(DESC, "State command dispatcher")
    field(SELM, "Specified")
    field(SELL, "$(P):$(R):STATE_SP NPP")
    field(DOL0, "4")
    field(LNK0, "$(P):$(R):CMD_VAL PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):POWER_ON_SEQ.PROC PP")
    field(DOL2, "1")
    field(LNK2, "$(P):$(R):CMD_VAL PP")
    field(DOL3, "8")
    field(LNK3, "$(P):$(R):CMD_VAL PP")
}

# Power On is only accepted from Standby: from the energized state (OFF) go
# through Standby first, then Power On after ON_DLY seconds.
record(calc, "$(P):$(R):POWER_ON_FIRST") {
    field(DESC, "First command for ON")
    field(INPA, "$(P):$(R):STATE_BASE NPP NMS")
    field(CALC, "A=0?1:2")
}

record(seq, "$(P):$(R):POWER_ON_SEQ") {
    field(DESC, "Standby then Power On")
    field(SELM, "All")
    field(DOL1, "$(P):$(R):POWER_ON_FIRST PP")
    field(LNK1, "$(P):$(R):CMD_VAL PP")
    field(DLY2, "$(ON_DLY=3)")
    field(DOL2, "2")
    field(LNK2, "$(P):$(R):CMD_VAL PP")
}

# The cubicle has no current setpoint: SP_NOT_REACHED is always 0
record(calc, "$(P):$(R):SP_NOT_REACHED") {
    field(DESC, "No setpoint check on cubicle")
    field(CALC, "0")
    field(PINI, "YES")
}

include "hzacc_unimag_state.template"
