# hzacc_cubicle.db - Hazemeyer CHV TL "accumulatore" cubicle (MMU)
#
# The cubicle holds 8 channels (MAU0..MAU7, 10 A, 15/20 V), all reached
# through the Main Monitoring Unit (MMU) Modbus slave. This database covers
# the cubicle itself: general state machine, general faults, mains
# measurements and the MAU ready / power status words used by the channels
# (hzacc_channel.template).
#
# Modbus map (MMU database, see docs/, all word addresses):
#   $0000        write  general commands  B0 Standby, B1 Power On, B2 Power Off,
#                                         B3 Reset, B4 Active energy reset,
#                                         B5 Reactive energy reset
#   $0080-$009D  read   mains measurements
#   $00C0        read   general faults   (copy of $0020)
#   $00C1        read   general statuses (copy of $0021)
#   $00C2        read   MAU ready  (bit n = MAUn, 1 Ready / 0 Faulty)
#   $00C3        read   MAU power  (bit n = MAUn, 1 On / 0 Off)
#
# Macros:
#   P, R        PV prefix ($(P):$(R):...)
#   PORT_MEAS   modbus port reading the word area $0080-$00CB (asyn addr 0 = $0080)
#   PORT_CMD    modbus port writing the command words $0000-$001F (asyn addr 0 = $0000)
#   TIMEOUT     asyn timeout (ms)
#   PULSE       command pulse width (s, default 0.5)
#   ON_DLY      delay between Standby and Power On when switching ON from
#               the energized state (s, default 3)
#   U_SLO, I_SLO, P_SLO, Q_SLO, S_SLO, PF_SLO, E_SLO, IE_SLO, F_SLO
#               raw -> engineering scaling of the mains measurements (default 1)

record(stringout, "$(P):$(R):SWVER") {
    field(DESC, "Software IOC Version")
    field(VAL,  "$(SWVER=1.0.0)")
    field(PINI, "YES")
}

########################################################################################
### General faults ($00C0)
########################################################################################

record(mbbiDirect, "$(P):$(R):GEN_FAULTS") {
    field(DESC, "General faults word")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_MEAS) 64 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "16")
    field(SCAN, "I/O Intr")
}

record(bi, "$(P):$(R):TRANSFO_OT") {
    field(DESC, "Transformer over-temperature")
    field(INP,  "$(P):$(R):GEN_FAULTS.B0 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):RECTIFIER_OT") {
    field(DESC, "Rectifier over-temperature")
    field(INP,  "$(P):$(R):GEN_FAULTS.B1 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):CHOKE_OT") {
    field(DESC, "Filter choke over-temperature")
    field(INP,  "$(P):$(R):GEN_FAULTS.B2 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

