########################################################################################
### General statuses ($00C1)
########################################################################################

record(mbbiDirect, "$(P):$(R):GEN_STATUS") {
    field(DESC, "General statuses word")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_MEAS) 65 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "16")
    field(SCAN, "I/O Intr")
}

record(bi, "$(P):$(R):READY") {
    field(DESC, "Ready status")
    field(INP,  "$(P):$(R):GEN_STATUS.B0 CP MS")
    field(ZNAM, "FAULTY")
    field(ONAM, "READY")
    field(ZSV,  "MAJOR")
}

record(bi, "$(P):$(R):STANDBY_STS") {
    field(DESC, "Standby status")
    field(INP,  "$(P):$(R):GEN_STATUS.B1 CP MS")
