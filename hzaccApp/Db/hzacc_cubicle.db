# Polarity not stated in the manual: check on the cubicle
record(bi, "$(P):$(R):LOC_REM") {
    field(DESC, "Local / Remote status")
    field(INP,  "$(P):$(R):GEN_STATUS.B3 CP MS")
    field(ZNAM, "LOCAL")
    field(ONAM, "REMOTE")
}

record(bi, "$(P):$(R):RESET_PB") {
    field(DESC, "Reset push button status")
    field(INP,  "$(P):$(R):GEN_STATUS.B4 CP MS")
    field(ZNAM, "RELEASED")
    field(ONAM, "PRESSED")
}

# Any general fault bit or cubicle not ready
record(calc, "$(P):$(R):ALL_FAULT") {
    field(DESC, "Cubicle fault summary")
    field(INPA, "$(P):$(R):READY CP MS")
    field(INPB, "$(P):$(R):GEN_FAULTS CP MS")
    field(CALC, "(!A||(B&4095))?1:0")
    field(HIGH, "1")
    field(HSV,  "MAJOR")
}

########################################################################################
### MAU ready / power words ($00C2, $00C3) - used by the channels
########################################################################################

record(mbbiDirect, "$(P):$(R):MAU_READY") {
    field(DESC, "MAU ready bits (1 Ready)")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_MEAS) 66 0x00FF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "8")
    field(SCAN, "I/O Intr")
}

record(mbbiDirect, "$(P):$(R):MAU_POWER") {
    field(DESC, "MAU power bits (1 On)")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_MEAS) 67 0x00FF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "8")
    field(SCAN, "I/O Intr")
}

