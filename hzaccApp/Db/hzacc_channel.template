# hzacc_channel.template - one channel (MAU) of the Hazemeyer CHV TL cubicle
#
# Each channel is a UNIMAG power supply of its own ($(P):$(R):...). Loaded
# 8 times by hzacc_channels.substitutions, next to hzacc_cubicle.db.
#
# Channel state descriptor (Power, Ready): OFF 01, ON 11, Faulty 00.
# Ready and power come from the cubicle words $00C2/$00C3 (bit CH).
# Channel ON switches the cubicle ON too (see ON_REQ).
#
# Macros:
#   P, R        PV prefix of the channel ($(P):$(R):...)
#   CUB         R of the cubicle ($(P):$(CUB):..., hzacc_cubicle.db)
#   CH          MAU number 0-7 (bit in the MAU ready / power words)
#   PORT_MEAS2  modbus port of the word area $00A0-$00CB (asyn addr 0 = $00A0)
#   PORT_STS    modbus port of the status area $0020-$003F (asyn addr 0 = $0020)
#   PORT_CMD    modbus port of the command words $0000-$001F (asyn addr 0 = $0000)
#   PORT_ISET   modbus port of the current settings $0060-$0067 (asyn addr 0 = $0060)
#   IRB         asyn addr of the output current in PORT_MEAS2 ($00C4+CH  -> 36+CH)
#   VRB         asyn addr of the output voltage in PORT_MEAS2 ($00A1+4CH -> 1+4CH)
#   FLT         asyn addr of the MAU fault word in PORT_STS   ($0030+2CH -> 16+2CH)
#   STS         asyn addr of the MAU status word in PORT_STS  ($0031+2CH -> 17+2CH)
#   CMD         asyn addr of the MAU command word in PORT_CMD ($0010+2CH -> 16+2CH)
#   ISET        asyn addr of the current setting in PORT_ISET ($0060+CH  -> CH)
#   IMAX        full scale current (A, default 10)
#   VMAX        full scale voltage (V, default 20)
#   RAWMAX_SP   raw current setting at IMAX (default 2048). The settings are
#               signed (bipolar correctors), -RAWMAX_SP..RAWMAX_SP
#   RAWMAX_RB   raw current / voltage readback at IMAX / VMAX (default 8192),
#               signed. Both measured against the reference control system:
#               raw setting 410 -> 2.000 A, raw readback 1644 -> 2.000 A
#   TIMEOUT     asyn timeout (ms)
#   PULSE       command pulse width (s, default 0.5)
#   SET_TOLERANCE, ZERO_TOLERANCE, SET_TIMEOUT_S  UNIMAG watchdog settings

########################################################################################
### Current setpoint ($0060+CH)
########################################################################################

record(ao, "$(P):$(R):CURRENT_SP") {
    field(DESC, "Channel set current")
    field(EGU,  "A")
    field(PREC, "3")
    field(DRVL, "-$(IMAX=10)")
    field(DRVH, "$(IMAX=10)")
    field(LOPR, "-$(IMAX=10)")
    field(HOPR, "$(IMAX=10)")
    field(FLNK, "$(P):$(R):CALC_CURRENT_RAW")
}

record(calcout, "$(P):$(R):CALC_CURRENT_RAW") {
    field(DESC, "Convert current to raw value")
    field(INPA, "$(P):$(R):CURRENT_SP NPP")
    field(CALC, "FLOOR(A*$(RAWMAX_SP=2048)/$(IMAX=10)+0.5)")
    field(OUT,  "$(P):$(R):RAW_CURRENT_SP PP")
}

record(ao, "$(P):$(R):RAW_CURRENT_SP") {
    field(DESC, "Raw current setpoint")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT_ISET),$(ISET),$(TIMEOUT))MODBUS_DATA")
    field(DRVL, "-$(RAWMAX_SP=2048)")
    field(DRVH, "$(RAWMAX_SP=2048)")
}

# Current setting as held by the MMU (read back by the write port at boot)
record(calc, "$(P):$(R):SET_CURRENT_RB") {
    field(DESC, "Set current readback")
    field(INPA, "$(P):$(R):RAW_CURRENT_SP CP MS")
    field(CALC, "A*$(IMAX=10)/$(RAWMAX_SP=2048)")
    field(EGU,  "A")
    field(PREC, "3")
}

########################################################################################
### Output readbacks
########################################################################################

record(ai, "$(P):$(R):RAW_CURRENT_RB") {
    field(DESC, "Raw output current")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT_MEAS2),$(IRB),$(TIMEOUT))MODBUS_DATA")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):CURRENT_RB")
}

record(calc, "$(P):$(R):CURRENT_RB") {
    field(DESC, "Output current readback")
    field(INPA, "$(P):$(R):RAW_CURRENT_RB NPP MS")
    field(CALC, "A*$(IMAX=10)/$(RAWMAX_RB=8192)")
    field(EGU,  "A")
    field(PREC, "3")
    field(LOPR, "-$(IMAX=10)")
    field(HOPR, "$(IMAX=10)")
}

record(ai, "$(P):$(R):RAW_VOLTAGE_RB") {
    field(DESC, "Raw output voltage")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT_MEAS2),$(VRB),$(TIMEOUT))MODBUS_DATA")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):VOLTAGE_RB")
}

record(calc, "$(P):$(R):VOLTAGE_RB") {
    field(DESC, "Output voltage readback")
    field(INPA, "$(P):$(R):RAW_VOLTAGE_RB NPP MS")
    field(CALC, "A*$(VMAX=20)/$(RAWMAX_RB=8192)")
    field(EGU,  "V")
    field(PREC, "3")
    field(LOPR, "-$(VMAX=20)")
    field(HOPR, "$(VMAX=20)")
}

########################################################################################
### Ready / power ($00C2 / $00C3, bit CH)
########################################################################################

record(bi, "$(P):$(R):READY") {
    field(DESC, "MAU ready")
    field(INP,  "$(P):$(CUB):MAU_READY.B$(CH) CP MS")
    field(ZNAM, "FAULTY")
    field(ONAM, "READY")
    field(ZSV,  "MAJOR")
}

record(bi, "$(P):$(R):OPERATIONAL") {
    field(DESC, "MAU power status")
    field(INP,  "$(P):$(CUB):MAU_POWER.B$(CH) CP MS")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}

record(bi, "$(P):$(R):ALL_FAULT") {
    field(DESC, "Fault status")
    field(INP,  "$(P):$(R):FAULT_CALC CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(calc, "$(P):$(R):FAULT_CALC") {
    field(DESC, "Fault = not ready")
    field(INPA, "$(P):$(R):READY CP MS")
    field(CALC, "!A")
}

########################################################################################
### MAU detailed faults ($0030+2CH) and status ($0031+2CH)
########################################################################################

record(mbbiDirect, "$(P):$(R):MAU_FAULTS") {
    field(DESC, "MAU faults word")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_STS) $(FLT) 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "16")
    field(SCAN, "I/O Intr")
}

record(bi, "$(P):$(R):BALLAST_OT") {
    field(DESC, "Ballast over-temperature")
    field(INP,  "$(P):$(R):MAU_FAULTS.B0 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):FUSE_FAULT") {
    field(DESC, "Fuses fault")
    field(INP,  "$(P):$(R):MAU_FAULTS.B1 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):DC_OVERVOLTAGE") {
    field(DESC, "DC over-voltage")
    field(INP,  "$(P):$(R):MAU_FAULTS.B2 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):DC_OVERCURRENT") {
    field(DESC, "DC over-current")
    field(INP,  "$(P):$(R):MAU_FAULTS.B3 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(bi, "$(P):$(R):COMM_FAIL") {
    field(DESC, "MAU communication failure")
    field(INP,  "$(P):$(R):MAU_FAULTS.B4 CP MS")
    field(ZNAM, "OK")
    field(ONAM, "FAULT")
    field(OSV,  "MAJOR")
}

record(mbbiDirect, "$(P):$(R):MAU_STATUS") {
    field(DESC, "MAU status word")
    field(DTYP, "asynUInt32Digital")
    field(INP,  "@asynMask($(PORT_STS) $(STS) 0xFFFF $(TIMEOUT))MODBUS_DATA")
    field(NOBT, "16")
    field(SCAN, "I/O Intr")
}

# The MAU status word only has the power bit (B1 is reserved): the
# Local / Remote status is the cubicle one ($0021 B3)
record(bi, "$(P):$(R):LOC_REM") {
    field(DESC, "Local / Remote status")
    field(INP,  "$(P):$(CUB):LOC_REM CP MS")
    field(ZNAM, "LOCAL")
    field(ONAM, "REMOTE")
}

########################################################################################
### Commands ($0010+2CH) - pulsed: B0 Power On, B1 Power Off, B2 Reset
########################################################################################

record(ao, "$(P):$(R):CMD_WORD") {
    field(DESC, "MAU command word")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT_CMD),$(CMD),$(TIMEOUT))MODBUS_DATA")
}

record(ao, "$(P):$(R):CMD_VAL") {
    field(DESC, "Command code to pulse")
    field(FLNK, "$(P):$(R):CMD_PULSE")
}

record(seq, "$(P):$(R):CMD_PULSE") {
    field(DESC, "Pulse the command word")
    field(SELM, "All")
    field(DOL1, "$(P):$(R):CMD_VAL NPP")
    field(LNK1, "$(P):$(R):CMD_WORD PP")
    field(DLY2, "$(PULSE=0.5)")
    field(DOL2, "0")
    field(LNK2, "$(P):$(R):CMD_WORD PP")
}

########################################################################################
### UNIMAG state
########################################################################################
# CONN_FAULT when the ready word cannot be read or the MAU reports a CITBus
# communication failure, EXT_INTLK when the cubicle is faulty, FAULT when the
# MAU is not ready, then ON / OFF from the power bit. A MAU powered on while
# the cubicle is not in Power On delivers no current: it reads STANDBY.

record(calcout, "$(P):$(R):STATE_RB_CALC") {
    field(DESC, "State readback")
    field(INPA, "$(P):$(R):READY CP")
    field(INPB, "$(P):$(R):OPERATIONAL CP")
    field(INPC, "$(P):$(CUB):READY CP")
    field(INPD, "$(P):$(R):READY.SEVR CP NMS")
    field(INPE, "$(P):$(R):COMM_FAIL CP NMS")
    field(INPF, "$(P):$(CUB):POWER_STS CP")
    field(CALC, "(D>=3||E)?5:(!C?4:(!A?3:(B?(F?1:2):0)))")
    field(OUT,  "$(P):$(R):STATE_BASE PP")
    field(OOPT, "Every Time")
}

record(mbbo, "$(P):$(R):STATE_SP") {
    field(DESC, "State setpoint")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FLNK, "$(P):$(R):ON_CANCEL")
}

# Any command other than ON drops a pending ON
record(calcout, "$(P):$(R):ON_CANCEL") {
    field(DESC, "Cancel pending ON")
    field(INPA, "$(P):$(R):STATE_SP NPP")
    field(CALC, "A!=1")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(P):$(R):ON_PENDING PP")
    field(FLNK, "$(P):$(R):STATE_DISPATCH")
}

# OFF and STANDBY -> Power Off (2), ON -> see ON_REQ, RESET -> Reset (4)
record(seq, "$(P):$(R):STATE_DISPATCH") {
    field(DESC, "State command dispatcher")
    field(SELM, "Specified")
    field(SELL, "$(P):$(R):STATE_SP NPP")
    field(DOL0, "2")
    field(LNK0, "$(P):$(R):CMD_VAL PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):ON_REQ.PROC PP")
    field(DOL2, "2")
    field(LNK2, "$(P):$(R):CMD_VAL PP")
    field(DOL3, "4")
    field(LNK3, "$(P):$(R):CMD_VAL PP")
}

# Channel ON also switches the cubicle ON: the MAUs only deliver current with
# the cubicle in Power On. Cubicle ON (STATE_BASE 1): Power On the MAU now.
# Cubicle OFF / STANDBY: switch the cubicle ON and Power On the MAU once the
# cubicle power bit is set. Cubicle faulty or unreachable: nothing is sent
# (the channel shows EXT_INTLK / CONN_FAULT; reset the cubicle explicitly).
# Channel OFF never switches the cubicle off (the other channels share it).
record(calcout, "$(P):$(R):ON_REQ") {
    field(DESC, "ON request")
    field(INPA, "$(P):$(CUB):STATE_BASE NPP NMS")
    field(CALC, "A=1?1:(A=0||A=2?6:0)")
    field(OUT,  "$(P):$(R):ON_ACTION.SELN PP")
    field(OOPT, "Every Time")
}

# SELN bit mask: 1 MAU Power On, 2 set ON_PENDING, 4 cubicle ON
record(seq, "$(P):$(R):ON_ACTION") {
    field(DESC, "ON actions")
    field(SELM, "Mask")
    field(SHFT, "0")
    field(DOL0, "1")
    field(LNK0, "$(P):$(R):CMD_VAL PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):ON_PENDING PP")
    field(DOL2, "1")
    field(LNK2, "$(P):$(CUB):STATE_SP PP")
}

record(bo, "$(P):$(R):ON_PENDING") {
    field(DESC, "ON waits for the cubicle")
    field(ZNAM, "NO")
    field(ONAM, "WAITING")
}

# Cubicle reached Power On with an ON pending: Power On the MAU
record(calcout, "$(P):$(R):ON_PENDING_GO") {
    field(DESC, "Cubicle ON, finish channel ON")
    field(INPA, "$(P):$(CUB):POWER_STS CP")
    field(INPB, "$(P):$(R):ON_PENDING CP")
    field(CALC, "A&&B")
    field(OOPT, "Transition To Non-zero")
    field(OUT,  "$(P):$(R):ON_FIRE.PROC PP")
}

record(seq, "$(P):$(R):ON_FIRE") {
    field(DESC, "Power On after cubicle ON")
    field(SELM, "All")
    field(DOL0, "0")
    field(LNK0, "$(P):$(R):ON_PENDING PP")
    field(DOL1, "1")
    field(LNK1, "$(P):$(R):CMD_VAL PP")
}

# Cubicle went faulty or unreachable: drop the pending ON
record(calcout, "$(P):$(R):ON_PENDING_ABORT") {
    field(DESC, "Cubicle fault, drop pending ON")
    field(INPA, "$(P):$(CUB):STATE_BASE CP")
    field(INPB, "$(P):$(R):ON_PENDING CP")
    field(CALC, "B&&A>=3")
    field(OOPT, "When Non-zero")
    field(DOPT, "Use OCAL")
    field(OCAL, "0")
    field(OUT,  "$(P):$(R):ON_PENDING PP")
}

include "hzacc_unimag_state.template"
include "hzacc_unimag_setpoint.template"
